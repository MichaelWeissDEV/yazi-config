# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=arch-dotfiles-yazi
pkgver=0.3.0
pkgrel=1
pkgdesc='Yazi file manager configuration and plugins'
arch=('any')
url='https://github.com/MichaelWeissDEV/dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('arch-dotfiles-core>=0.3.0' 'yazi' 'file' 'jq' 'fd' 'ripgrep' 'fzf' 'zoxide' 'poppler' 'imagemagick' 'ffmpeg' '7zip')
optdepends=()
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
